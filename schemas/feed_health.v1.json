      "default": null,
      "title": "Last Message At"
    },
    "late": {
      "minimum": 0,
      "title": "Late",
      "type": "integer"
    },
    "malformed": {
      "minimum": 0,
      "title": "Malformed",
      "type": "integer"
    },
    "messages": {
      "minimum": 0,
      "title": "Messages",
      "type": "integer"
    },
    "next_attempt_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
