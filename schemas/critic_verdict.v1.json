{
  "$defs": {
    "CriticVerdictKind": {
      "enum": [
        "PASS",
        "REDUCE",
        "DENY"
      ],
      "title": "CriticVerdictKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Evidence Refs",
      "type": "array"
    },
    "max_notional": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Notional"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Reason Codes",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/CriticVerdictKind"
    }
  },
  "required": [
    "verdict",
    "proposal_id",
    "model_version",
    "prompt_version"
  ],
  "title": "CriticVerdict",
  "type": "object"
}
